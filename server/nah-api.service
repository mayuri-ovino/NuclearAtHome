# systemd unit for the read-only API (Raspberry Pi or any Linux server).
# Install: sudo cp server/nah-api.service /etc/systemd/system/ && sudo systemctl enable --now nah-api
[Unit]
Description=Nuclear@Home read-only API (gunicorn)
After=network.target postgresql.service

[Service]
User=nah
WorkingDirectory=/opt/nuclear-at-home
Environment=NAH_API_PG_DSN=dbname=nuclear user=nah
ExecStart=/usr/bin/gunicorn --bind 127.0.0.1:8000 --workers 2 stats.api:application
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
