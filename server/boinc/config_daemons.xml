<!-- Fragment for the BOINC project's config.xml (inside <config> and <daemons>).
     Paths assume this repo is checked out at /opt/nuclear-at-home on the server.
     VERIFY ON THE STAGING SERVER (Phase 9, T-082): the macro names script_validator and
     script_assimilator pass (wu_id, runtime, files, files2), the exit-code meanings, and
     whether BOINC's adaptive replication is on for the app (D3). -->
<config>
  <reliable_on_priority>10</reliable_on_priority>  <!-- outlier confirmation WUs go to reliable hosts -->
</config>
<daemons>
  <daemon><cmd>feeder -d 3</cmd></daemon>
  <daemon><cmd>transitioner -d 3</cmd></daemon>
  <daemon><cmd>file_deleter -d 3</cmd></daemon>
  <daemon>
    <cmd>script_validator -d 3 --app nuclear_cascade --credit_from_wu
      --init_script "python3 -I /opt/nuclear-at-home/validator/validate_init.py wu_id runtime files"
      --compare_script "python3 -I /opt/nuclear-at-home/validator/validate_compare.py wu_id runtime files runtime2 files2"</cmd>
  </daemon>
  <daemon>
    <cmd>script_assimilator -d 3 --app nuclear_cascade
      --script "python3 -I /opt/nuclear-at-home/server/assimilator.py wu_id files"</cmd>
  </daemon>
</daemons>
