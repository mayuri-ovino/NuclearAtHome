<!-- Fragment for the BOINC project's config.xml (inside <config> and <daemons>).
     Paths assume this repo is checked out at /opt/nuclear-at-home on the server.
     Script names are looked up in the project's bin/ (BOINC runs ../bin/<name>): install the
     wrappers from server/boinc/bin/ there. Macros and exit codes checked against BOINC master
     source (2026-11-01): init_script gets result_id/runtime/files; exit 3 = transient retry.
     Still verify on staging: adaptive replication for the app (D3). -->
<config>
  <reliable_on_priority>10</reliable_on_priority>  <!-- outlier confirmation WUs go to reliable hosts -->
</config>
<daemons>
  <daemon><cmd>feeder -d 3</cmd></daemon>
  <daemon><cmd>transitioner -d 3</cmd></daemon>
  <daemon><cmd>file_deleter -d 3</cmd></daemon>
  <daemon>
    <cmd>script_validator -d 3 --app nuclear_cascade --credit_from_wu
      --init_script "nah_validate_init result_id runtime files"
      --compare_script "nah_validate_compare"</cmd>
  </daemon>
  <daemon>
    <cmd>script_assimilator -d 3 --app nuclear_cascade
      --script "nah_assimilate wu_name files"</cmd>
  </daemon>
</daemons>
<!-- cron (project user), with flock so only one generator runs:
     */10 * * * * flock -n /home/boincadm/projects/nuclear/nah_wg.lock python3 -I /opt/nuclear-at-home/server/work_generator.py
     15 * * * *   python3 -I /opt/nuclear-at-home/stats/jobs.py hourly
     30 0 * * *   python3 -I /opt/nuclear-at-home/stats/jobs.py daily -->
