<!-- BOINC input template for cascade WUs. LAMMPS opens files by plain name, so every
     file is copied into the slot (BOINC soft links are not readable by LAMMPS). -->
<input_template>
  <file_info><number>0</number><sticky/><no_delete/></file_info>
  <file_info><number>1</number></file_info>
  <file_info><number>2</number><sticky/><no_delete/></file_info>
  <file_info><number>3</number><sticky/><no_delete/></file_info>
  <file_info><number>4</number><sticky/><no_delete/></file_info>
  <workunit>
    <file_ref><file_number>0</file_number><open_name>in.cascade.lmp</open_name><copy_file/></file_ref>
    <file_ref><file_number>1</file_number><open_name>params.lmp</open_name><copy_file/></file_ref>
    <file_ref><file_number>2</file_number><open_name>potential.mod</open_name><copy_file/></file_ref>
    <file_ref><file_number>3</file_number><open_name>potential.dat</open_name><copy_file/></file_ref>
    <file_ref><file_number>4</file_number><open_name>stopping.dat</open_name><copy_file/></file_ref>
  </workunit>
</input_template>
