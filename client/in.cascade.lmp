# Nuclear@Home cascade work unit (LAMMPS input, run by BOINC's stock wrapper).
#
# Every physics value comes from params.lmp, which the server renders from
# config/settings.toml (mirror of docs/interfaces/physics_settings.md). The
# potential (pair_style, pair_coeff, ZBL join) comes from potential.mod.
#
# Outputs (all in the slot directory):
#   log.lammps        echoed commands and thermo (the server checks the echoed params)
#   energy.txt        step time etotal thermostat_removed electronic_loss, one row per check
#   history.txt       step time n_frenkel max_boundary_ke_ev, one row per check
#   snapshots.dump    sparse frames for the viewer
#   final.dump        all atoms at the end, for server-side Wigner-Seitz analysis
#   run.state         counters and stop reason
#   progress.txt      fraction done, read by the wrapper
#   checkpoint.state  checkpoint pointer, watched by the wrapper
# After a restart, energy.txt and history.txt may repeat steps; the server keeps the
# last row written for each step (analysis/lammps_output.py).

log             log.lammps append
echo            log
include         params.lmp

units           metal
atom_style      atomic
atom_modify     map array
boundary        p p p
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

lattice         ${lat} ${a0}
region          box block 0 ${n} 0 ${n} 0 ${n}
create_box      1 box
create_atoms    1 box
include         potential.mod

# Reference sites: the perfect lattice, captured before anything moves. On resume the
# lattice is rebuilt identically and the checkpointed positions are read on top, so the
# Wigner-Seitz reference survives restarts.
fix             ref all store/state 0 x y z
compute         ws all voronoi/atom occupation
variable        vac atom c_ws[1]==0
compute         nvac all reduce sum v_vac
compute         ke all ke/atom
compute         kesum all reduce sum c_ke
variable        snap atom (c_ke>${snap_ke})||(c_ws[1]!=1)

# Outermost fcells cells are held fixed during the cascade; the next tcells cells are the
# thermostat layer; the core is free NVE (Warrier & Bhardwaj protocol).
variable        inner equal v_fcells+v_tcells
region          mobile block ${fcells} $(v_n-v_fcells) ${fcells} $(v_n-v_fcells) ${fcells} $(v_n-v_fcells)
region          core block ${inner} $(v_n-v_inner) ${inner} $(v_n-v_inner) ${inner} $(v_n-v_inner)
group           mobile region mobile
group           core region core
group           fixed subtract all mobile
group           edge subtract mobile core
group           outer subtract all core

thermo_style    custom step time dt temp etotal c_nvac c_kesum
thermo          ${check_steps}
run             0
fix             nve all nve

# Windows: a crash between the two steps of the checkpoint swap below leaves only the complete .tmp.
if "$(is_file(checkpoint.state)) == 0 && $(is_file(checkpoint.state.tmp)) == 1" then &
  "shell mv checkpoint.state.tmp checkpoint.state"
if "$(is_file(checkpoint.state)) == 1" then "jump SELF resume"

# ---------------------------------------------------------------- fresh start
shell           rm -f energy.txt history.txt snapshots.dump
variable        n_restarts equal 0
variable        n_ckpt equal 0
variable        icheck equal 0
variable        off_thermo equal 0.0
variable        off_elec equal 0.0
variable        prev_file string none
variable        ck_dt equal ${dt_max}

# PKA: the atom on the lattice site at the box center, picked while the lattice is perfect.
region          pkasite sphere $(floor(v_n/2)) $(floor(v_n/2)) $(floor(v_n/2)) 0.1
group           pka region pkasite
if "$(count(pka)) != 1" then "print 'ERROR: PKA site does not hold exactly one atom'" "quit 3"

velocity        all create ${temp} ${seed} dist gaussian mom yes rot yes
fix             eq all langevin ${temp} ${temp} ${tdamp} ${seed}
timestep        ${dt_max}
# Progress counts MD steps (the work), not simulated time: the warm-up is about a quarter of the
# steps and the first cascade femtoseconds take many tiny steps, so time-based progress made BOINC
# extrapolate days for 1-2 hour tasks. cascade_min = cascade steps at the largest timestep.
variable        cascade_min equal ceil(${max_time}/${dt_max})
run             0
# Warm-up in chunks only to report progress; "pre no" continues the same dynamics exactly.
label           equil
run             $(ternary(v_equil_steps-step<v_check_steps,v_equil_steps-step,v_check_steps)) pre no post no
print           "$(step/(v_equil_steps+v_cascade_min))" file progress.txt screen no
if "$(step) < ${equil_steps}" then "jump SELF equil"
unfix           eq
velocity        fixed set 0.0 0.0 0.0
reset_timestep  0 time 0.0

variable        am atom mass
compute         pkam pka reduce max v_am
thermo_style    custom step c_pkam
run             0
# Speed from E = m v^2 / 2; 1.0364269e-4 is LAMMPS's metal-units mvv2e (eV per g/mol A^2/ps^2).
variable        vpka equal sqrt(2.0*${pka_e}/($(c_pkam)*1.0364269e-4))
velocity        pka set $(v_vpka*v_pka_dx) $(v_vpka*v_pka_dy) $(v_vpka*v_pka_dz) units box
# Logged so the server can check this run started from this WU's PKA site and direction.
print           "PKA_START $(xcm(pka,x)) $(xcm(pka,y)) $(xcm(pka,z))"
uncompute       pkam
variable        fpref equal 0
variable        tref equal 0.0
jump            SELF cascade

# ---------------------------------------------------------------- resume
label           resume
include         checkpoint.state
variable        n_restarts equal $(v_n_restarts+1)
read_dump       ${ck_file} ${ck_step} x y z vx vy vz ix iy iz box no replace yes
reset_timestep  ${ck_step} time ${ck_time}

# ---------------------------------------------------------------- cascade
label           cascade
fix             freeze fixed setforce 0.0 0.0 0.0
fix             th edge langevin ${temp} ${temp} ${tdamp} $(v_seed+1+v_n_restarts) tally yes
fix             es all electron/stopping ${es_cutoff} stopping.dat
fix             dtr all dt/reset 1 NULL ${dt_max} ${dx_max} units box
timestep        ${ck_dt}
# f_th (tally yes) is the energy the thermostat removed and f_es the electronic loss, but
# LAMMPS resets both at the start of every run, so totals are carried across the chunks.
variable        thermo_rm equal ${off_thermo}
variable        elec_loss equal ${off_elec}
variable        cascade_min equal ceil(${max_time}/${dt_max})
# Steps done over steps done plus the fewest still needed (at the largest timestep): rises steadily to 1.
variable        frac equal ternary(time<${max_time},(${equil_steps}+step)/(${equil_steps}+step+(${max_time}-time)/${dt_max}),1.0)
# Highest kinetic energy outside the free core: a recoil reaching the thermostat or fixed layer.
compute         keb outer reduce max c_ke
thermo_style    custom step time dt temp etotal c_nvac c_kesum c_keb f_th f_es
thermo          ${check_steps}
run             0
if "${n_restarts} == 0" then &
  "print '$(step) $(time) $(etotal) $(v_thermo_rm) $(v_elec_loss)' append energy.txt screen no" &
  "print '$(step) $(time) $(c_nvac) $(c_keb)' append history.txt screen no"

label           loop
run             ${check_steps} pre no post no  # no re-setup per chunk: per-run GPU setup leaked ~17 MB each (2.6 GB per 150 runs, 128k atoms)
variable        thermo_rm equal $(v_thermo_rm+f_th)
# With pre no, f_es (electron/stopping) keeps summing from the last full setup (the run 0 above),
# while f_th (langevin tally) restarts each run; both measured 2026-11-02, LAMMPS 29Aug2024.
variable        elec_loss equal $(v_off_elec+f_es)
variable        icheck equal $(v_icheck+1)
print           "$(step) $(time) $(etotal) $(v_thermo_rm) $(v_elec_loss)" append energy.txt screen no
print           "$(step) $(time) $(c_nvac) $(c_keb)" append history.txt screen no
print           "$(v_frac)" file progress.txt screen no
if "${icheck} == 1" then "print 'PKA_FIRST $(xcm(pka,x)) $(xcm(pka,y)) $(xcm(pka,z))'"
if "$(abs(c_nvac-v_fpref)) > ${stop_tol}" then "variable fpref equal $(c_nvac)" "variable tref equal $(time)"
if "$(v_icheck%v_snap_every) == 0" then &
  "write_dump all custom snapshots.dump id type x y z c_ke c_ws[1] f_ref[1] f_ref[2] f_ref[3] modify append yes thresh v_snap == 1"
if "$(v_icheck%v_ckpt_every) == 0" then "jump SELF checkpoint"
label           after_checkpoint
if "$(time) >= ${max_time}" then "variable stop_reason string hard_limit" "jump SELF done"
if "$(time-v_tref) >= ${stop_window}" then "variable stop_reason string stabilized" "jump SELF done"
jump            SELF loop

# ---------------------------------------------------------------- checkpoint
# The dump is named by step and written first; checkpoint.state (the file the wrapper
# watches) is replaced atomically last, so a crash never leaves it pointing at a
# missing or partial dump.
label           checkpoint
variable        n_ckpt equal $(v_n_ckpt+1)
variable        ck_name string ckpt.$(step).dump
write_dump      all custom ${ck_name} id type x y z vx vy vz ix iy iz modify sort id format float %.17g
print           """
variable ck_step equal $(step)
variable ck_time equal $(time)
variable ck_dt equal $(dt)
variable ck_file string ${ck_name}
variable n_restarts equal ${n_restarts}
variable n_ckpt equal ${n_ckpt}
variable icheck equal ${icheck}
variable off_thermo equal $(v_thermo_rm)
variable off_elec equal $(v_elec_loss)
variable fpref equal ${fpref}
variable tref equal ${tref}
variable prev_file string ${ck_name}
""" file checkpoint.state.tmp screen no
shell           mv checkpoint.state.tmp checkpoint.state
# Windows cannot rename onto an existing file (LAMMPS warns and leaves .tmp): remove the old pointer
# first. The .tmp is complete by now, and the resume check above recovers it if a crash falls between.
if "$(is_file(checkpoint.state.tmp)) == 1" then "shell rm checkpoint.state" "shell mv checkpoint.state.tmp checkpoint.state"
shell           rm -f ${prev_file}
variable        prev_file string ${ck_name}
jump            SELF after_checkpoint

# ---------------------------------------------------------------- done
label           done
print           "1.0" file progress.txt screen no
# Positions to 1e-6 A (upload 7.2 -> 3.8 MB gzipped; checkpoints keep %.17g). Rounding can flip a
# Wigner-Seitz assignment only for an atom within ~1e-6 A of a cell boundary: measured ~3e-5 per
# result (1e-4 A would be ~3e-3, and V6 would reject those valid results). physics_settings.md.
write_dump      all custom final.dump id type x y z ix iy iz modify sort id format float %.6f
print           """
md_steps $(step)
simulated_time_ps $(time)
n_atoms $(atoms)
checkpoints_written ${n_ckpt}
restarts ${n_restarts}
stop_reason ${stop_reason}
""" file run.state screen no
