{
  "permissions": {
    "allow": [
      "Bash(bash scripts/run-tests.sh)",
      "Bash(bash scripts/new-task.sh *)",
      "Bash(python3 -m pytest *)",
      "Bash(python3 -m unittest *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(./secrets/**)",
      "Read(./**/*.priv)",
      "Read(./**/*private_key*)",
      "Read(./.env)",
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/scripts/guard_frozen.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/scripts/guard_frozen.py\""
          }
        ]
      }
    ]
  }
}
